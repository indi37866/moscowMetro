<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="#000000">

    <TextView
        android:id="@+id/tvResultTimeText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_margin="50dp"
        android:text="@string/result_time_text"
        android:textSize="33sp"
        android:textColor="#FCFF00"
        android:textStyle="bold"
    />

    <TextView
        android:id="@+id/tvResultTime"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@id/tvResultTimeText"
        app:layout_constraintEnd_toEndOf="@id/tvResultTimeText"
        app:layout_constraintStart_toStartOf="@id/tvResultTimeText"
        android:text="@string/result_time"
        android:textSize="33sp"
        android:textColor="#FF0000"
        android:textStyle="italic"
        android:gravity="center"
        android:background="@drawable/bg_rounded_text"
        />

    <TextView
        android:id="@+id/tvStationCountText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@id/tvResultTime"
        app:layout_constraintStart_toStartOf="@id/tvResultTime"
        app:layout_constraintEnd_toEndOf="@id/tvResultTime"
        android:layout_margin="80dp"
        android:text="@string/station_count_text"
        android:textSize="25sp"
        android:textColor="#FCFF00"
        />

    <TextView
        android:id="@+id/tvStationCount"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@id/tvStationCountText"
        app:layout_constraintEnd_toEndOf="@id/tvResultTimeText"
        app:layout_constraintStart_toStartOf="@id/tvResultTimeText"
        android:text="@string/station_count"
        android:textSize="33sp"
        android:textColor="#FF0000"
        android:textStyle="italic"
        android:gravity="center"
        android:background="@drawable/bg_rounded_text"
        />
</androidx.constraintlayout.widget.ConstraintLayout>